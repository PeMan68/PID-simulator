{
  "id": "kaskad-demo-langsam-slav",
  "version": "v1.0.0",
  "title": "Kaskadreglering — demo: felaktigt trimmad slavslinga",
  "description": "Samma kaskadstruktur och samma störning som föregående steg, men slavslingan är nu feltrimmad (Kp=0,3, Ti=60 istället för Kp=2,0, Ti=6) — inte längre tydligt snabbare än huvudslingan. Numeriskt verifierat (uppföljning efter PO-test): topp-avvikelse ca 15,9 enheter och ca 1050 stegs återhämtning — SÄMRE än enkelslingan i steg 1 (ca 13,9 enheter, 470 steg), trots att kaskadstrukturen i sig är oförändrad.",
  "tags": ["pid", "kaskadreglering", "varmevaxlare"],
  "process": {
    "type": "self_regulating",
    "K": 1.3,
    "T": 90.0,
    "L": 0.0,
    "normalValue": 50.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "pi",
    "kp": 0.6,
    "ti": 70.0,
    "td": 0.0,
    "antiWindup": true,
    "outputLimits": { "min": -50.0, "max": 50.0 }
  },
  "cascade": {
    "enabled": true,
    "inner": {
      "process": {
        "type": "self_regulating",
        "K": 1.0,
        "T": 8.0,
        "L": 0.0,
        "normalValue": 30.0,
        "measurementRange": { "min": 0.0, "max": 100.0 },
        "auxGain": 1.0
      },
      "controller": {
        "kp": 0.3,
        "ti": 60.0,
        "td": 0.0,
        "antiWindup": true,
        "outputLimits": { "min": 0.0, "max": 100.0 }
      }
    }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "auxSignal": { "magnitude": -35.0 },
  "runtime": { "dt": 1.0, "maxSteps": 1300, "setpoint": 50.0, "autopause": false }
}
