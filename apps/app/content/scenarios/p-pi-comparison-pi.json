{
  "id": "p-pi-comparison-pi",
  "version": "v1.0.0",
  "title": "P/PI-jämförelse — PI-reglering",
  "description": "Parameterstudieverifierad (PED-003B): eliminerar det kvarstående reglerfelet med minimal översläng (~1%), samma process som p-pi-comparison-p.",
  "tags": ["pi", "comparison", "self"],
  "process": {
    "type": "self_regulating",
    "K": 1.5,
    "T": 15.0,
    "L": 1.0,
    "normalValue": 0.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "pi",
    "kp": 1.0,
    "ti": 12.0,
    "td": 0.0,
    "antiWindup": true,
    "outputLimits": { "min": 0.0, "max": 100.0 }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "runtime": { "dt": 1.0, "maxSteps": 300, "setpoint": 60.0, "autopause": false }
}
