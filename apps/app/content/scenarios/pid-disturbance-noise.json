{
  "id": "pid-disturbance-noise",
  "version": "v1.0.0",
  "title": "PID med brus",
  "description": "Robusthetsfall med kontinuerlig brusstorning.",
  "tags": ["pid", "noise", "robustness"],
  "process": {
    "type": "self_regulating",
    "K": 1.0,
    "T": 20.0,
    "L": 5.0,
    "normalValue": 0.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "pid",
    "kp": 1.2,
    "ti": 12.0,
    "td": 2.0,
    "antiWindup": true,
    "outputLimits": { "min": 0.0, "max": 100.0 }
  },
  "disturbance": { "noiseStd": 3.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "runtime": { "dt": 1.0, "maxSteps": 900, "setpoint": 50.0, "autopause": false }
}
