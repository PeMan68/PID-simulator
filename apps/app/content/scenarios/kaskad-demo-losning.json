{
  "id": "kaskad-demo-losning",
  "version": "v1.0.0",
  "title": "Kaskadreglering — demo: kaskad (lösningen)",
  "description": "Samma värmeväxlare och samma störning som föregående steg, men nu med en inre flödesslinga (slavslinga) mellan huvudregulatorn och ventilen. Slavslingans PID-parametrar sätts av scenariot, inte av studenten (PO-beslut, DES-001). Numeriskt verifierat (uppföljning efter PO-test): topp-avvikelse ca 1,1 enheter (mot ca 13,9 utan kaskad) — återhämtning ca 55 steg.",
  "tags": ["pid", "kaskadreglering", "varmevaxlare"],
  "process": {
    "type": "self_regulating",
    "K": 1.3,
    "T": 90.0,
    "L": 0.0,
    "normalValue": 50.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "pi",
    "kp": 0.6,
    "ti": 70.0,
    "td": 0.0,
    "antiWindup": true,
    "outputLimits": { "min": -50.0, "max": 50.0 }
  },
  "cascade": {
    "enabled": true,
    "inner": {
      "process": {
        "type": "self_regulating",
        "K": 1.0,
        "T": 8.0,
        "L": 0.0,
        "normalValue": 30.0,
        "measurementRange": { "min": 0.0, "max": 100.0 },
        "auxGain": 1.0
      },
      "controller": {
        "kp": 2.0,
        "ti": 6.0,
        "td": 0.0,
        "antiWindup": true,
        "outputLimits": { "min": 0.0, "max": 100.0 }
      }
    }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "auxSignal": { "magnitude": -35.0 },
  "runtime": { "dt": 1.0, "maxSteps": 500, "setpoint": 50.0, "autopause": false }
}
