{
  "id": "lambda-pi-conservative",
  "version": "v1.0.0",
  "title": "Lambda PI — konservativt λ (λ = 3T = 60)",
  "description": "PI-reglering med Lambda-inställning λ=3T=60. Kp=0.21, Ti=20. Långsam men mycket robust.",
  "tags": ["lambda", "pi", "self", "conservative"],
  "process": {
    "type": "self_regulating",
    "K": 1.5,
    "T": 20.0,
    "L": 5.0,
    "normalValue": 0.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "pi",
    "kp": 0.21,
    "ti": 20.0,
    "td": 0,
    "antiWindup": true,
    "outputLimits": { "min": 0.0, "max": 100.0 }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "runtime": { "dt": 1.0, "maxSteps": 300, "setpoint": 60.0, "autopause": false }
}
