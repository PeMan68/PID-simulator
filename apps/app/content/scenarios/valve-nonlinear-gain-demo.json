{
  "id": "valve-nonlinear-gain-demo",
  "version": "v1.0.0",
  "title": "Olinjär ventilkarakteristik — demo",
  "description": "Självreglerande process vars K varierar i två steg beroende på utsignalen u (FEAT-042): svag (K=0.5) under brytpunkt 1, stark (K=2.5) därutöver. Samma Kp ger tydligt olika svarskaraktär i de två driftområdena — simuleringsverifierat (se STRAT-003-uppföljningen i docs/reports/).",
  "tags": ["pid", "gain-schedule", "nonlinear", "self"],
  "process": {
    "type": "self_regulating",
    "K": 1.3,
    "T": 15.0,
    "L": 0.0,
    "normalValue": 0.0,
    "measurementRange": { "min": 0.0, "max": 100.0 },
    "nonlinearGain": {
      "enabled": true,
      "breakpoint1": 25,
      "breakpoint2": 65,
      "zones": [0.5, 2.5, 2.5]
    }
  },
  "controller": {
    "mode": "pi",
    "kp": 1.2,
    "ti": 20.0,
    "td": 0.0,
    "antiWindup": true,
    "outputLimits": { "min": 0.0, "max": 100.0 },
    "gainSchedule": {
      "enabled": false,
      "breakpoint1": 25,
      "breakpoint2": 65,
      "zones": [
        { "kp": 5.0, "ti": 20.0, "td": 0.0 },
        { "kp": 1.2, "ti": 20.0, "td": 0.0 },
        { "kp": 1.2, "ti": 20.0, "td": 0.0 }
      ]
    }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "runtime": { "dt": 1.0, "maxSteps": 250, "setpoint": 10.0, "autopause": false }
}
