{
  "id": "onoff-basic",
  "version": "v1.0.0",
  "title": "On/Off grundläggande",
  "description": "Enkel on/off-reglering. Visar oscillation runt SP och hur hysteres påverkar.",
  "tags": ["onoff", "step", "self"],
  "process": {
    "type": "self_regulating",
    "K": 1.0,
    "T": 10.0,
    "L": 0.0,
    "normalValue": 0.0,
    "measurementRange": { "min": 0.0, "max": 100.0 }
  },
  "controller": {
    "mode": "onoff",
    "kp": 0,
    "ti": 0,
    "td": 0,
    "antiWindup": false,
    "outputLimits": { "min": 0.0, "max": 100.0 },
    "hysteresis": { "lower": 2.0, "upper": 2.0 }
  },
  "disturbance": { "noiseStd": 0.0, "pulse": { "magnitude": 0.0, "durationSteps": 0 } },
  "runtime": { "dt": 1.0, "maxSteps": 300, "setpoint": 50.0, "autopause": false }
}
