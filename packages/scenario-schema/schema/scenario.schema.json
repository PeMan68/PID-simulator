{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pid-simulator.local/schema/scenario.schema.json",
  "title": "PID Scenario",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "process",
    "controller",
    "runtime"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "process": {
      "type": "object",
      "required": [
        "type",
        "K",
        "T",
        "L",
        "normalValue",
        "measurementRange"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "self_regulating",
            "integrating",
            "unstable"
          ]
        },
        "K": {
          "type": "number"
        },
        "T": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "L": {
          "type": "number",
          "minimum": 0
        },
        "normalValue": {
          "type": "number"
        },
        "outflow": {
          "type": "number",
          "default": 0
        },
        "dimensionlessK": {
          "type": "boolean",
          "default": false
        },
        "measurementRange": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "description": "Validation rule max > min should be enforced in application-level validation."
        }
      },
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "required": [
        "mode",
        "outputLimits"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "onoff",
            "p",
            "pi",
            "pid",
            "manual"
          ]
        },
        "kp": {
          "type": "number",
          "default": 0
        },
        "ti": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "td": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "antiWindup": {
          "type": "boolean",
          "default": true
        },
        "manualOutput": {
          "type": "number"
        },
        "onoff": {
          "type": "object",
          "properties": {
            "hysteresisType": {
              "type": "string",
              "enum": [
                "both",
                "upper",
                "lower"
              ],
              "default": "both"
            },
            "high": {
              "type": "number",
              "default": 2
            },
            "low": {
              "type": "number",
              "default": 2
            }
          },
          "additionalProperties": false
        },
        "outputLimits": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "disturbance": {
      "type": "object",
      "properties": {
        "noiseStd": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "pulse": {
          "type": "object",
          "properties": {
            "magnitude": {
              "type": "number",
              "default": 0
            },
            "durationSteps": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "dt",
        "maxSteps",
        "setpoint"
      ],
      "properties": {
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "setpoint": {
          "type": "number"
        },
        "autopause": {
          "type": "boolean",
          "default": false
        },
        "stopAtTime": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
